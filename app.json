{
  "expo": {
    "name": "RotaCash: Despesas e Recibos",
    "slug": "rotacash-despesas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#2563EB"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o RotaCash acessar a câmera para escanear comprovantes e notas fiscais."
        }
      ]
    ],
    "android": {
      "package": "com.rotacash.despesas",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "15199ac4-dcd5-4332-a834-fc290472eae0"
      }
    }
  }
}